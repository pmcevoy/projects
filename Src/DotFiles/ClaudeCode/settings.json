{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "permissions": {
    "allow": [
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git commit *)",
      "mcp__jetbrains__read_file",
      "mcp__jetbrains__get_file_text_by_path",
      "mcp__jetbrains__search_text",
      "mcp__jetbrains__search_regex",
      "mcp__jetbrains__search_file",
      "mcp__jetbrains__search_in_files_by_text",
      "mcp__jetbrains__search_in_files_by_regex",
      "mcp__jetbrains__search_symbol",
      "mcp__jetbrains__get_symbol_info",
      "mcp__jetbrains__find_files_by_glob",
      "mcp__jetbrains__find_files_by_name_keyword",
      "mcp__jetbrains__list_directory_tree",
      "mcp__jetbrains__get_all_open_file_paths",
      "mcp__jetbrains__get_solution_projects",
      "mcp__jetbrains__get_project_dependencies",
      "mcp__jetbrains__get_run_configurations",
      "mcp__jetbrains__get_repositories",
      "mcp__jetbrains__get_file_problems",
      "mcp__jetbrains__generate_psi_tree",
      "mcp__jetbrains__generate_inspection_kts_api",
      "mcp__jetbrains__generate_inspection_kts_examples",
      "mcp__jetbrains__open_file_in_editor",
      "mcp__jetbrains__build_solution",
      "Bash(cd * && git log*)",
      "Bash(cd * && git show*)",
      "Bash(cd * && git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git diff*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout *)",
      "PowerShell(git pull *)",
      "PowerShell(git fetch *)",
      "PowerShell(git branch *)",
      "PowerShell(msbuild *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)"
    ],
    "deny": [
      "Bash(git push*)",
      "PowerShell(git push*)"
    ],
    "ask": [
      "mcp__jetbrains__create_new_file",
      "mcp__jetbrains__replace_text_in_file",
      "mcp__jetbrains__reformat_file",
      "mcp__jetbrains__rename_refactoring",
      "mcp__jetbrains__move_type_to_namespace",
      "mcp__jetbrains__execute_run_configuration",
      "mcp__jetbrains__execute_terminal_command",
      "mcp__jetbrains__run_inspection_kts"
    ]
  },
  "model": "sonnet",
  "defaultShell": "powershell",
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "frontend-design@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark-ansi"
}
